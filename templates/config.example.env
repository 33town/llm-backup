# llm-backup 設定。install.sh 會把它複製成 ~/.config/llm-backup/config.env，之後改那份就好。
# 這是 bash 檔（會被 source），不要放任何金鑰值。

# 你的 LLM 設定備份 repo（private）放哪。⚠️ 不要放在 ~/Documents、~/Desktop、~/Downloads：
# macOS 不讓 launchd 背景程式讀這幾個資料夾（見 docs/PITFALLS.md #1）。
LLM_HOME="$HOME/llm-home"

# 放「從 ~/Documents 搬出來的 .git」的地方，讓 launchd 能 push（見 PITFALLS #1）
GIT_STORE="$HOME/git-store"

# launchd label 前綴（例：com.yourname）。plist 會叫 <前綴>.llm-home.backup、<前綴>.repos.backup、<前綴>.restic
LABEL_PREFIX="com.$(id -un)"

# 每天幾點跑（本機時區）。挑你「通常已經開機」的時間；睡著錯過的排程醒來會補跑一次。
BACKUP_HOUR=12
BACKUP_MINUTE=30

# 要檢查乾淨與否的工作 repo（check-repos.sh 用）。路徑有空白沒關係。
REPO_PATHS=(
  "$LLM_HOME"
  # "$HOME/Documents/MY PROJECT"
)

# macOS 鑰匙圈裡三組 restic／儲存空間的 service 名稱（值本身由 setup-secrets.sh 讓你當場輸入）
KC_RESTIC_PASSWORD="restic-backup"
KC_S3_KEY_ID="restic-s3-key-id"
KC_S3_SECRET="restic-s3-secret"

# restic forget 保留規則（每週日跑）
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
